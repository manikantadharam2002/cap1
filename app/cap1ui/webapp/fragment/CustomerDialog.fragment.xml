<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Dialog
        id="customerDialog"
        title="{dialogModel>/title}"
        contentWidth="400px">

        <content>

            <VBox class="sapUiMediumMargin">

                <Label text="Name" />
                <Input
                    value="{dialogModel>/name}"
                    placeholder="Enter customer name" />

                <Label
                    text="Email"
                    class="sapUiSmallMarginTop" />

                <Input
                    value="{dialogModel>/email}"
                    placeholder="Enter email"
                    type="Email" />

                <Label
                    text="City"
                    class="sapUiSmallMarginTop" />

                <Input
                    value="{dialogModel>/city}"
                    placeholder="Enter city" />

            </VBox>

        </content>

        <beginButton>

            <Button
                text="Save"
                type="Emphasized"
                press=".onSaveCustomer" />

        </beginButton>

        <endButton>

            <Button
                text="Cancel"
                press=".onCancelDialog" />

        </endButton>

    </Dialog>

</core:FragmentDefinition>